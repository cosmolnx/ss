"""
agent/core/audit.py â€” append-only audit trail for every tool invocation
LANUX-S5's Agent Core makes, whether auto-approved, approved, denied, or
blocked by the Sandbox underneath.

Storage format follows the exact pattern already used by
self_improvement/experiment.py's ExperimentLog/_log() â€” one JSON object per
line, appended, never rewritten or truncated â€” rather than inventing a new
persistence mechanism. This keeps the audit log human-readable and
inspectable with any text tool, consistent with the project's existing
"no cloud service, no opaque binary store" philosophy (see agent/memory.py).
"""

from __future__ import annotations

import json
import os
import time
import uuid
from dataclasses import asdict, dataclass, field


@dataclass
class AuditEntry:
    id: str
    timestamp: float
    task_id: str | None
    subtask_id: str | None
    actor: str                  # "LANUX-S5" | "<AgentRole value>" | "user" | "system"
    tool_name: str | None
    risk: str | None            # RiskLevel.value, kept as str here to avoid
                                 # a hard import dependency on permissions.py
    action: str                 # "auto_approved" | "approval_requested" |
                                 # "approved" | "denied" | "expired" |
                                 # "cancelled" | "executed" |
                                 # "blocked_by_sandbox" | "error"
    detail: str = ""
    # Phase S.5 â€” deliberately a SEPARATE concept from `actor` above, never
    # conflated with it:
    #   `actor`      = who/what actually PERFORMED this operation (a
    #                    component or role â€” "LANUX-S5", an AgentRole
    #                    value, "system"). Can legitimately change several
    #                    times across one task's execution (e.g. as the
    #                    Controller routes a subtask to different
    #                    specialists) â€” see ExecutionContext.actor, which
    #                    the Controller mutates per routing decision.
    #   `originator` = the AUTHENTICATED PROVENANCE of the task this
    #                    operation happened under â€” i.e. the Task's own
    #                    trust_origin (agent.core.task.TrustOrigin), fixed
    #                    once when the Task was created and never mutated
    #                    afterward. Valid values are exactly
    #                    "MASTER_AUTHENTICATED" and "LOCAL_UNAUTHENTICATED"
    #                    (kept as plain str here for the same reason `risk`
    #                    above is: to avoid a hard import dependency on
    #                    agent.core.task). None means "no known task
    #                    provenance for this entry" (e.g. a system-level
    #                    maintenance record with no task_id at all, or a
    #                    legacy entry recorded before this field existed) â€”
    #                    NEVER interpreted as authenticated, and NEVER
    #                    upgraded to a real value by guessing.
    #
    # `originator` is set exactly once, by AuditLog.record() below, from
    # server-side state that ultimately traces back to Task.trust_origin
    # (or a TaskStore lookup keyed by task_id when no live Task object is
    # available, e.g. during startup recovery) â€” never from a caller-
    # supplied free-form string, never from model output, never from a
    # specialist, and never from request/model/file/web content. See
    # AuditLog.record()'s docstring for the validation this relies on.
    originator: str | None = None


def _new_id() -> str:
    return f"audit-{uuid.uuid4().hex[:12]}"


# Mirrors agent.core.task.TrustOrigin's two constants exactly. Duplicated
# as plain strings, not imported, for the same reason `risk` is handled as
# a plain str above â€” this module stays free of a hard dependency on
# agent.core.task. If agent.core.task.TrustOrigin ever gains a third value,
# this set must be updated too (a test in tests/test_trust_origin.py or
# tests/test_audit.py should catch drift between the two).
_VALID_ORIGINATORS = frozenset({"MASTER_AUTHENTICATED", "LOCAL_UNAUTHENTICATED"})


class AuditLog:
    """Append-only JSON-lines audit log."""

    def __init__(self, path: str):
        self.path = path
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        if not os.path.exists(path):
            # touch the file so `read_all` on a brand-new log doesn't error
            with open(path, "a", encoding="utf-8"):
                pass

    def record(
        self,
        actor: str,
        action: str,
        task_id: str | None = None,
        subtask_id: str | None = None,
        tool_name: str | None = None,
        risk: str | None = None,
        detail: str = "",
        originator: str | None = None,
    ) -> AuditEntry:
        """
        `originator` (Phase S.5) must be either None or exactly one of
        _VALID_ORIGINATORS above. This is deliberately re-checked here,
        at the single point every audit entry is actually written,
        rather than trusted from any caller: if something upstream ever
        passes a bogus or caller-influenced string (a bug, a careless
        future edit, anything other than a real Task.trust_origin value
        or a safe None), it is normalized to None rather than persisted
        verbatim. This is the last line of defense against an audit
        record ever falsely claiming "MASTER_AUTHENTICATED" â€” silence
        (None) is always the safe failure mode here, never an upgrade.
        """
        if originator is not None and originator not in _VALID_ORIGINATORS:
            originator = None

        entry = AuditEntry(
            id=_new_id(),
            timestamp=time.time(),
            task_id=task_id,
            subtask_id=subtask_id,
            actor=actor,
            tool_name=tool_name,
            risk=risk,
            action=action,
            detail=detail,
            originator=originator,
        )
        with open(self.path, "a", encoding="utf-8") as f:
            f.write(json.dumps(asdict(entry)) + "\n")
        return entry

    def read_all(self) -> list[AuditEntry]:
        entries: list[AuditEntry] = []
        with open(self.path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                data = json.loads(line)
                entries.append(AuditEntry(**data))
        return entries

    def for_task(self, task_id: str) -> list[AuditEntry]:
        return [e for e in self.read_all() if e.task_id == task_id]
